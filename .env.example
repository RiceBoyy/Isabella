# Copy to .env. Never commit .env.
# The key is in ~/.hermes-isabella/.env as API_SERVER_KEY.
HERMES_BASE_URL=http://127.0.0.1:8643
HERMES_API_KEY=
HERMES_MODEL=qwen3:4b-16k
MAX_TOKENS=3000

# Must equal HERMES_TIMEZONE on her Hermes instance. Reconcile compares the two
# and refuses on mismatch - Hermes has no per-job timezone, so a disagreement
# means the briefing fires at the wrong hour every day, silently.
HERMES_TIMEZONE=Europe/Copenhagen
